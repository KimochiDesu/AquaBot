TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
GUILD_ID=your_guild_id_here
MOD_LOG_CHANNEL_ID=your_mod_log_channel_id
WELCOME_CHANNEL_ID=your_welcome_channel_id
AUTO_ROLE_ID=your_auto_role_id

# Axis Cult form receiver (posts signed membership sheets from the portfolio site to #forms)
FORM_PORT=8787
# Optional: the #forms channel's ID. Without it the bot uses a text channel named "forms".
FORMS_CHANNEL_ID=
# Optional: sites allowed to send forms, comma-separated.
FORM_ORIGINS=https://kimochidesu.github.io
# Optional: any random text; mixed into the hashes that remember who has already pledged.
FORM_SALT=change-me
